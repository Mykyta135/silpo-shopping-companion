# Copy to .env and fill in. Never commit .env — it is gitignored.

# Anthropic API key for the agent loop.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
AGENT_MODEL=claude-sonnet-5

# Official Silpo MCP server.
SILPO_MCP_URL=https://mcp.silpo.ua/mcp

# OAuth 2.1 redirect target — must match what the client registers via DCR.
OAUTH_CALLBACK_URL=http://localhost:3000/auth/silpo/callback

# Where server-side MCP tokens are persisted (gitignored, mode 0600).
# Replace with a database or secrets manager for anything beyond a demo.
MCP_TOKEN_STORE_PATH=.mcp-tokens.json

# Active shopping list per session. Holds guest purchase data — gitignored.
LIST_STORE_PATH=.shopping-lists.json

PORT=3010

# Canned model output for a reproducible demo (no model cost). MCP calls stay real.
DEMO_MODE=false
