# Copy to .env. EXPO_PUBLIC_* values are embedded in the bundle in plain text —
# put ONLY non-sensitive values here. Never an API key or MCP token.

# Use the LAN IP of the dev machine when running on a physical device.
EXPO_PUBLIC_API_URL=http://localhost:3010

# Point at an already-authorized session during development.
# EXPO_PUBLIC_SESSION_ID=my-session
